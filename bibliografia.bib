% ============================================================================
% BAZA ŹRÓDEŁ
% ============================================================================
% Każdy wpis ma unikalny klucz, np. lamport1994. W tekście źródło przywołuje
% się poleceniem \cite{lamport1994}. Nie wpisuj numerów cytowań ręcznie — LaTeX
% nada je automatycznie.
%
% Autorów rozdzielaj słowem "and", także w źródłach polskojęzycznych.
% Zachowaj przecinek po każdym polu. Usuń lub zakomentuj przykłady, których nie
% wykorzystujesz w raporcie.
% ============================================================================

% Przykład książki:
@book{lamport1994,
  author    = {Leslie Lamport},
  title     = {LaTeX: A Document Preparation System},
  edition   = {2},
  year      = {1994},
  publisher = {Addison-Wesley}
}

% Drugi przykładowy wpis książkowy:
@book{mittelbach2004,
  author    = {Frank Mittelbach and Michel Goossens and Johannes Braams and David Carlisle and Chris Rowley},
  title     = {The LaTeX Companion},
  edition   = {2},
  year      = {2004},
  publisher = {Addison-Wesley}
}

% Przykład artykułu naukowego — usuń znak % z każdego wiersza i uzupełnij dane:
% @article{kowalski2026,
%   author  = {Jan Kowalski and Anna Nowak},
%   title   = {Tytuł artykułu},
%   journal = {Nazwa czasopisma},
%   year    = {2026},
%   volume  = {10},
%   number  = {2},
%   pages   = {1--12},
%   doi     = {10.0000/przykladowy-doi}
% }

